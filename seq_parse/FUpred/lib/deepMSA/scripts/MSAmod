#!/usr/bin/perl
#PBS -e !ERRFILE!
#PBS -o !OUTFILE!
#PBS -l !WALLTIME!
#PBS -l !NODE!

=pod

  * This script calls build_MSA.py (developed by Chengxin Zhang) to generate MSA using 
   the concepts incorporated in METAPSICOV2. Here are the brief steps that are performed 
   by "build_MSA.py" script:

  -- First round of search is done by searching query sequence through uniclust30 
     database using hhblits.
     (hhblits + uniclust30)

  -- If number of effective sequence (NF) is less than a cut-off (right now 64), then 
     a next round of search is done using qjakchmmer through uniref90. The raw sequences from 
     the second round of search is built into a custom hhsuite database to be searched 
     by hhblits, jump-starting from alignment generated by the previous round
     (qjakchmmer + uniref90 => hhsuite-database)
     (hhblits (pre-MSA) + hhsuite-database)

  -- If NF is still less than the cut-off, then another round of search is performed 
     using qhmmsearch through metagenome sequence databases. The raw sequences from this 
     round of search is again built into a custom hhsuite database to be searched by hhblits, 
     jump-starting from the alignment generated by the previous rounds
     (hmmsearch -(pre_MSA) + metaclust => protein.aln)

 * input for build_MSA.py:
   protein.fasta

 * output from build_MSA.py:
   protein.aln (Final MSA)
 
 * Usage of build_MSA.py:
  -- option 1 (uniclust30+uniref90+metaclust): 
  ./build_MSA.py protein.fasta -hhblitsdb=$hhblitsdb -jackhmmerdb=$jackhmmerdb -hmmsearchdb=$hmmsearchdb1

  -- option 2 (uniclust30+uniref90+metaclust+tara): 
  ./build_MSA.py protein.fasta -hhblitsdb=$hhblitsdb -jackhmmerdb=$jackhmmerdb -hmmsearchdb=$hmmsearchdb1:$hmmsearchdb2

=cut

$s="!S!";
$o="";

## reporting node --->
`hostname`=~/(\S+)/;
$node=$1;
printf "hostname: $node\n";
$time=`date`;
printf "starting time: $time";
$pwd=`pwd`;
printf "pwd: $pwd";

########### program #################################
#$build_msa="/nfs/amino-home/zhng/library/yzhang/contact/NEW/hhsuite2/scripts/build_MSA_yz$o.py";
#$build_msa="/nfs/amino-home/zhng/pdbinput/contact/bin/hhsuite2/scripts/build_MSA$o.py";
#$build_msa="/nfs/amino-home/zhng/pdbinput/contact/bin/hhsuite_wei1/scripts/build_MSA$o.py";
#$build_msa="/nfs/amino-home/zhng/pdbinput/contact/bin/hhsuite_wei2/scripts/build_MSA$o.py";
$build_msa="/nfs/amino-home/zhng/pdbinput/contact/bin/hhsuite_wei3/scripts/build_MSA$o.py"; # for $o=12, resPRE.data.74

########### databases #################################
$hhblitsdb="/nfs/amino-home/zhng/local_library/uniclust30_2017_04/uniclust30_2017_04"; #31G
$jackhmmerdb="/nfs/amino-home/zhng/local_library/uniref90/uniref90.fasta"; #43G
$hmmsearchdb1="/nfs/amino-home/zhng/local_library/metaclust/metaclust.fasta"; #113G
$hmmsearchdb2="/nfs/amino-home/zhng/local_library/tara/taraprotein_all_final.fasta"; #49G

######## directory ########################################
$data_dir="!DATA_DIR!/!S!";  #for seq.txt and init.dat
$work_dir="/tmp/!USER!/!TAG!";
$MSA_dir="$data_dir/MSA"; #for depositing MSA files
`mkdir -p $MSA_dir`;

################ working directory ########################
`/bin/rm -fr $work_dir`;
`/bin/mkdir -p $work_dir`;
chdir "$work_dir";

######### seq.txt and Lch ------------------>
`cp $data_dir/seq.txt ./`;
@seqtxts=`cat ./seq.txt`;
$sequence="";
foreach $seqtxt(@seqtxts){
    goto pos6 if($seqtxt=~/\>/);
    $seqtxt=~s/\s//mg;
    $seqtxt=~s/\n//mg;
    $sequence=$sequence.$seqtxt;
  pos6:;
}
$Lch=length $sequence;
open(seq,">$work_dir/protein.fasta");
printf seq ">protein\n";
for($i=1;$i<=$Lch;$i++){
    $a=substr($sequence,$i-1,1);
    printf seq "$a";
    $seqQ{$i}=$a;   #only for check
    if($i==int($i/60)*60){
        printf seq "\n";
    }
}
printf seq "\n";
close(seq);
################ decide ncpu ###############
$ncpu=1
if($Lch>=400)
{
   $ncpu=2
}
if($Lch>=800)
{
   $ncpu=4
}
if($Lch>=1000)
{
   $ncpu=16
}

=pod

query----------------------               ---------------
  |                       |               |             |
  |(hhblits)              |(jackhmmer)    |             |(hmmsearch)
  |                       |               |             v
------------           ----------         |       ----------------
|uniclust30|           |uniref90|         |       |metaclust+tara|
------------           ----------         |       ----------------
  |                       |               |             |
  |                       |(cluster)      |             |
  |     (hhblits)         v               |             v
  -------------------->[hmm DB]------------           [MSA](protein.aln)

=cut


###################
system("$build_msa $work_dir/protein.fasta -hhblitsdb=$hhblitsdb -jackhmmerdb=$jackhmmerdb -hmmsearchdb=$hmmsearchdb1 -ncpu=$ncpu"); ## option 1
#system("$build_msa $work_dir/protein.fasta -hhblitsdb=$hhblitsdb -jackhmmerdb=$jackhmmerdb -hmmsearchdb=$hmmsearchdb1:$hmmsearchdb2"); ## option 2

`/bin/cp $work_dir/protein.aln $MSA_dir/protein.aln$o`;

system("/nfs/amino-home/zhng/casp_server/bin/mk_contact.pl $s");

################# endding procedure ######################
$time=`date`;
printf "ending time: $time";
`sync`;
`sync`;
sleep(1);
`rm -rf $work_dir`;

exit();
